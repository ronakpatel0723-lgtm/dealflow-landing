          "value": "10",
          "phrase": "10.0x entry EBITDA multiple"
        },
        {
          "assumption_id": "sponsor_equity",
          "value": "1.625e+09",
          "phrase": "$1.625B of sponsor equity"
        },
        {
          "assumption_id": "debt_ebitda_multiple",
          "value": "3.5",
          "phrase": "3.5x debt/EBITDA"
        },
        {
          "assumption_id": "moic",
